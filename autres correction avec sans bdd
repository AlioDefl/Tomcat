```java
package modele;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

/**
 * DAO (Data Access Object) pour la table plat
 * Gère toutes les requêtes vers la base de données
 */
public class PlatDAO {
    
    // ══════════════════════════════════════════════════════════
    // CONSTANTES DE CONNEXION
    // ══════════════════════════════════════════════════════════
    private static final String URL = "jdbc:postgresql://localhost:5432/restaurant";
    private static final String USER = "postgres";
    private static final String PASS = "postgres";
    
    // ══════════════════════════════════════════════════════════
    // FIND BY CATEGORIE
    // Récupère tous les plats d'une catégorie
    // ══════════════════════════════════════════════════════════
    public List<Plat> findByCategorie(String categorie) {
        List<Plat> liste = new ArrayList<>();
        String sql = "SELECT * FROM plat WHERE categorie = ? ORDER BY nom";
        
        Connection cnx = null;
        PreparedStatement pstmt = null;
        ResultSet rs = null;
        
        try {
            // Connexion
            cnx = DriverManager.getConnection(URL, USER, PASS);
            
            // Préparer la requête
            pstmt = cnx.prepareStatement(sql);
            pstmt.setString(1, categorie);
            
            // DEBUG : Afficher la requête
            System.out.println(pstmt);
            
            // Exécuter
            rs = pstmt.executeQuery();
            
            // Parcourir les résultats
            while (rs.next()) {
                Plat p = new Plat();
                p.setId(rs.getInt("id"));
                p.setNom(rs.getString("nom"));
                p.setPrix(rs.getDouble("prix"));
                p.setCategorie(rs.getString("categorie"));
                liste.add(p);
            }
            
        } catch (SQLException e) {
            System.out.println(e.getMessage());
            
        } finally {
            // Fermer les ressources
            try { if (rs != null) rs.close(); } catch (SQLException e) {}
            try { if (pstmt != null) pstmt.close(); } catch (SQLException e) {}
            try { if (cnx != null) cnx.close(); } catch (SQLException e) {}
        }
        
        return liste;
    }
    
    // ══════════════════════════════════════════════════════════
    // FIND BY ID
    // Récupère un plat par son ID
    // ══════════════════════════════════════════════════════════
    public Plat findById(int id) {
        Plat p = null;
        String sql = "SELECT * FROM plat WHERE id = ?";
        
        Connection cnx = null;
        PreparedStatement pstmt = null;
        ResultSet rs = null;
        
        try {
            cnx = DriverManager.getConnection(URL, USER, PASS);
            pstmt = cnx.prepareStatement(sql);
            pstmt.setInt(1, id);
            
            System.out.println(pstmt);
            
            rs = pstmt.executeQuery();
            
            if (rs.next()) {
                p = new Plat();
                p.setId(rs.getInt("id"));
                p.setNom(rs.getString("nom"));
                p.setPrix(rs.getDouble("prix"));
                p.setCategorie(rs.getString("categorie"));
            }
            
        } catch (SQLException e) {
            System.out.println(e.getMessage());
            
        } finally {
            try { if (rs != null) rs.close(); } catch (SQLException e) {}
            try { if (pstmt != null) pstmt.close(); } catch (SQLException e) {}
            try { if (cnx != null) cnx.close(); } catch (SQLException e) {}
        }
        
        return p;
    }
    
    // ══════════════════════════════════════════════════════════
    // FIND ALL
    // Récupère tous les plats
    // ══════════════════════════════════════════════════════════
    public List<Plat> findAll() {
        List<Plat> liste = new ArrayList<>();
        String sql = "SELECT * FROM plat ORDER BY categorie, nom";
        
        Connection cnx = null;
        Statement stmt = null;
        ResultSet rs = null;
        
        try {
            cnx = DriverManager.getConnection(URL, USER, PASS);
            stmt = cnx.createStatement();
            
            rs = stmt.executeQuery(sql);
            
            while (rs.next()) {
                Plat p = new Plat();
                p.setId(rs.getInt("id"));
                p.setNom(rs.getString("nom"));
                p.setPrix(rs.getDouble("prix"));
                p.setCategorie(rs.getString("categorie"));
                liste.add(p);
            }
            
        } catch (SQLException e) {
            System.out.println(e.getMessage());
            
        } finally {
            try { if (rs != null) rs.close(); } catch (SQLException e) {}
            try { if (stmt != null) stmt.close(); } catch (SQLException e) {}
            try { if (cnx != null) cnx.close(); } catch (SQLException e) {}
        }
        
        return liste;
    }
}
