## MenuControl.java (Partie 1 - Sans BDD)

```java
package controleur;

import jakarta.servlet.*;
import jakarta.servlet.http.*;
import jakarta.servlet.annotation.WebServlet;
import java.io.*;

@WebServlet("/MenuControl")
public class MenuControl extends HttpServlet {
    
    public void doGet(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        
        // ══════════════════════════════════════════════════════════
        // ENCODAGE UTF-8 - TOUJOURS EN PREMIER !
        // ══════════════════════════════════════════════════════════
        req.setCharacterEncoding("UTF-8");
        res.setContentType("text/html; charset=UTF-8");
        
        // ══════════════════════════════════════════════════════════
        // RÉCUPÉRER LA SESSION
        // true = crée la session si elle n'existe pas
        // ══════════════════════════════════════════════════════════
        HttpSession session = req.getSession(true);
        
        // ══════════════════════════════════════════════════════════
        // RÉCUPÉRER L'ACTION
        // ══════════════════════════════════════════════════════════
        String action = req.getParameter("action");
        if (action == null) {
            action = "entree";  // Action par défaut
        }
        
        // ══════════════════════════════════════════════════════════
        // SWITCH SUR L'ACTION
        // ══════════════════════════════════════════════════════════
        switch (action) {
            
            // ==================== PAGE ENTRÉE ====================
            case "entree":
                // Juste afficher la page (les radios sont en dur dans la JSP)
                req.getRequestDispatcher("/WEB-INF/vue/entree.jsp").forward(req, res);
                break;
            
            // ==================== VALIDER ENTRÉE ====================
            case "validerEntree":
                // Récupérer le choix du formulaire (name="entree" dans le radio)
                String entreeChoisie = req.getParameter("entree");
                
                // Stocker en session si non vide
                if (entreeChoisie != null && !entreeChoisie.isEmpty()) {
                    session.setAttribute("entree", entreeChoisie);
                }
                
                // Rediriger vers la page suivante (REDIRECT, pas forward !)
                res.sendRedirect("MenuControl?action=plat");
                break;
            
            // ==================== PAGE PLAT ====================
            case "plat":
                req.getRequestDispatcher("/WEB-INF/vue/plat.jsp").forward(req, res);
                break;
            
            // ==================== VALIDER PLAT ====================
            case "validerPlat":
                String platChoisi = req.getParameter("plat");
                
                if (platChoisi != null && !platChoisi.isEmpty()) {
                    session.setAttribute("plat", platChoisi);
                }
                
                res.sendRedirect("MenuControl?action=dessert");
                break;
            
            // ==================== PAGE DESSERT ====================
            case "dessert":
                req.getRequestDispatcher("/WEB-INF/vue/dessert.jsp").forward(req, res);
                break;
            
            // ==================== VALIDER DESSERT ====================
            case "validerDessert":
                String dessertChoisi = req.getParameter("dessert");
                
                if (dessertChoisi != null && !dessertChoisi.isEmpty()) {
                    session.setAttribute("dessert", dessertChoisi);
                }
                
                res.sendRedirect("MenuControl?action=recap");
                break;
            
            // ==================== PAGE RÉCAPITULATIF ====================
            case "recap":
                // Les données sont en session, la JSP les récupère directement
                req.getRequestDispatcher("/WEB-INF/vue/recap.jsp").forward(req, res);
                break;
            
            // ==================== RECOMMENCER ====================
            case "reset":
                // Vider toute la session
                session.invalidate();
                res.sendRedirect("MenuControl?action=entree");
                break;
            
            // ==================== PAR DÉFAUT ====================
            default:
                res.sendRedirect("MenuControl?action=entree");
        }
    }
    
    // POST appelle GET (pour gérer les formulaires)
    public void doPost(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        doGet(req, res);
    }
}
