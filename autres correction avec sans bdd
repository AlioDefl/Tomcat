```java
package controleur;

import modele.*;
import jakarta.servlet.*;
import jakarta.servlet.http.*;
import jakarta.servlet.annotation.WebServlet;
import java.io.*;

@WebServlet("/MenuControl")
public class MenuControl extends HttpServlet {
    
    // ══════════════════════════════════════════════════════════
    // DAO
    // ══════════════════════════════════════════════════════════
    private PlatDAO platDAO = new PlatDAO();
    
    public void doGet(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        
        req.setCharacterEncoding("UTF-8");
        res.setContentType("text/html; charset=UTF-8");
        
        HttpSession session = req.getSession(true);
        
        String action = req.getParameter("action");
        if (action == null) {
            action = "entree";
        }
        
        switch (action) {
            
            // ==================== PAGE ENTRÉE ====================
            case "entree":
                // NOUVEAU : Charger les entrées depuis la BDD
                req.setAttribute("plats", platDAO.findByCategorie("entree"));
                req.getRequestDispatcher("/WEB-INF/vue/entree.jsp").forward(req, res);
                break;
            
            // ==================== VALIDER ENTRÉE ====================
            case "validerEntree":
                String entreeIdStr = req.getParameter("entree");
                
                // NOUVEAU : On stocke l'ID (Integer) pas le nom
                if (entreeIdStr != null && !entreeIdStr.isEmpty()) {
                    session.setAttribute("entreeId", Integer.parseInt(entreeIdStr));
                }
                
                res.sendRedirect("MenuControl?action=plat");
                break;
            
            // ==================== PAGE PLAT ====================
            case "plat":
                req.setAttribute("plats", platDAO.findByCategorie("plat"));
                req.getRequestDispatcher("/WEB-INF/vue/plat.jsp").forward(req, res);
                break;
            
            // ==================== VALIDER PLAT ====================
            case "validerPlat":
                String platIdStr = req.getParameter("plat");
                
                if (platIdStr != null && !platIdStr.isEmpty()) {
                    session.setAttribute("platId", Integer.parseInt(platIdStr));
                }
                
                res.sendRedirect("MenuControl?action=dessert");
                break;
            
            // ==================== PAGE DESSERT ====================
            case "dessert":
                req.setAttribute("plats", platDAO.findByCategorie("dessert"));
                req.getRequestDispatcher("/WEB-INF/vue/dessert.jsp").forward(req, res);
                break;
            
            // ==================== VALIDER DESSERT ====================
            case "validerDessert":
                String dessertIdStr = req.getParameter("dessert");
                
                if (dessertIdStr != null && !dessertIdStr.isEmpty()) {
                    session.setAttribute("dessertId", Integer.parseInt(dessertIdStr));
                }
                
                res.sendRedirect("MenuControl?action=recap");
                break;
            
            // ==================== PAGE RÉCAPITULATIF ====================
            case "recap":
                // NOUVEAU : Charger les objets Plat depuis leurs IDs
                Integer entreeId = (Integer) session.getAttribute("entreeId");
                Integer platId = (Integer) session.getAttribute("platId");
                Integer dessertId = (Integer) session.getAttribute("dessertId");
                
                if (entreeId != null) {
                    req.setAttribute("entree", platDAO.findById(entreeId));
                }
                if (platId != null) {
                    req.setAttribute("plat", platDAO.findById(platId));
                }
                if (dessertId != null) {
                    req.setAttribute("dessert", platDAO.findById(dessertId));
                }
                
                req.getRequestDispatcher("/WEB-INF/vue/recap.jsp").forward(req, res);
                break;
            
            // ==================== RECOMMENCER ====================
            case "reset":
                session.invalidate();
                res.sendRedirect("MenuControl?action=entree");
                break;
            
            // ==================== PAR DÉFAUT ====================
            default:
                res.sendRedirect("MenuControl?action=entree");
        }
    }
    
    public void doPost(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        doGet(req, res);
    }
}
