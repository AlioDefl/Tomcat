package controleur;

import java.io.*;
import jakarta.servlet.*;
import jakarta.servlet.http.*;
import jakarta.servlet.annotation.WebServlet;
import modele.DAO;
import java.util.List;

@WebServlet("/control")
public class Control extends HttpServlet {
    
    public void doGet(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        doPost(req, res);
    }
    
    public void doPost(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        
        // Récupérer l'action demandée
        String action = req.getParameter("action");
        if (action == null) action = "liste";  // action par défaut
        
        // Instancier le modèle (DAO)
        DAO dao = new DAO();
        
        // Selon l'action, préparer les données et choisir la vue
        String vue = "";
        
        switch (action) {
            case "liste":
                // Récupérer toutes les données
                List<String> liste = dao.findAll();
                req.setAttribute("liste", liste);
                vue = "/WEB-INF/vue/Liste.jsp";
                break;
                
            case "vignette":
                // Récupérer un élément par son index
                int id = Integer.parseInt(req.getParameter("id"));
                String element = dao.findById(id);
                req.setAttribute("element", element);
                req.setAttribute("id", id);
                vue = "/WEB-INF/vue/Vignette.jsp";
                break;
                
            case "ajouter":
                String nouveau = req.getParameter("valeur");
                dao.create(nouveau);
                res.sendRedirect("control?action=liste");
                return;
                
            case "supprimer":
                int idSuppr = Integer.parseInt(req.getParameter("id"));
                dao.delete(idSuppr);
                res.sendRedirect("control?action=liste");
                return;
                
            default:
                vue = "/WEB-INF/vue/Liste.jsp";
        }
        
        // Forward vers la vue choisie
        RequestDispatcher rd = req.getRequestDispatcher(vue);
        rd.forward(req, res);
    }
}


