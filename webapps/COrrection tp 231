                    <%= joueur1.getPseudo() %>
                <% } else { %>
                    <%= joueur2.getPseudo() %>
                <% } %>
            </td>
        </tr>
    </table>
    
    <br>
    <a href="Control?action=modifier&id=<%= partie.getPno() %>">Modifier</a>
    <a href="Control?action=list">Retour à la liste</a>
</body>
</html>
```

