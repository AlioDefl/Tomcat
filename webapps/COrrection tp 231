public class DAO {
    private List<String> liste;
    
    public DAO() {
        // Données en dur (ou connexion BDD)
        liste = new ArrayList<>();
        liste.add("Premier élément");
        liste.add("Deuxième élément");
        liste.add("Troisième élément");
    }
    
    public List<String> findAll() {
        return liste;
    }
    
    public String findById(int id) {
        // Modulo pour éviter les dépassements
        return liste.get(id % liste.size());
    }
    
    public void create(String valeur) {
        liste.add(valeur);
    }
    
    public void delete(int id) {
        if (id >= 0 && id < liste.size()) {
            liste.remove(id);
        }
    }
}


