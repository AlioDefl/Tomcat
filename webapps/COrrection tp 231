package dao;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class JoueurDao {
    private DS ds;
    
    public JoueurDao() {
        this.ds = new DS();
    }
    
    // CREATE - Ajouter un joueur
    public void create(Joueur j) {
        String sql = "INSERT INTO joueur (pseudo, email, pwd, elo) VALUES (?, ?, ?, ?)";
        try (Connection cnx = ds.getConnection();
             PreparedStatement ps = cnx.prepareStatement(sql)) {
            ps.setString(1, j.getPseudo());
            ps.setString(2, j.getEmail());
            ps.setString(3, j.getPwd());
            ps.setInt(4, j.getElo());
            System.out.println(ps);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Erreur create: " + e.getMessage());
        }
    }
    
    // READ - Trouver par ID
    public Joueur findById(int id) {
        String sql = "SELECT * FROM joueur WHERE jno = ?";
        try (Connection cnx = ds.getConnection();
             PreparedStatement ps = cnx.prepareStatement(sql)) {
            ps.setInt(1, id);
            System.out.println(ps);
            ResultSet rs = ps.executeQuery();
            if (rs.next()) {
                return new Joueur(
                    rs.getInt("jno"),
                    rs.getString("pseudo"),
                    rs.getString("email"),
                    rs.getString("pwd"),
                    rs.getInt("elo")
                );
            }
        } catch (SQLException e) {
            System.out.println("Erreur findById: " + e.getMessage());
        }
        return null;
    }
    
    // READ ALL - Tous les joueurs
    public List<Joueur> findAll() {
        List<Joueur> liste = new ArrayList<>();
        String sql = "SELECT * FROM joueur ORDER BY elo DESC";
        try (Connection cnx = ds.getConnection();
             PreparedStatement ps = cnx.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {
            while (rs.next()) {
                liste.add(new Joueur(
                    rs.getInt("jno"),
                    rs.getString("pseudo"),
                    rs.getString("email"),
                    rs.getString("pwd"),
                    rs.getInt("elo")
                ));
            }
        } catch (SQLException e) {
            System.out.println("Erreur findAll: " + e.getMessage());
        }
        return liste;
    }
    
    // UPDATE - Modifier un joueur
    public void update(Joueur j) {
        String sql = "UPDATE joueur SET pseudo=?, email=?, elo=? WHERE jno=?";
        try (Connection cnx = ds.getConnection();
             PreparedStatement ps = cnx.prepareStatement(sql)) {
            ps.setString(1, j.getPseudo());
            ps.setString(2, j.getEmail());
            ps.setInt(3, j.getElo());
            ps.setInt(4, j.getJno());
            System.out.println(ps);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Erreur update: " + e.getMessage());
        }
    }
    
    // DELETE - Supprimer un joueur
    public void delete(int id) {
        String sql = "DELETE FROM joueur WHERE jno = ?";
        try (Connection cnx = ds.getConnection();
             PreparedStatement ps = cnx.prepareStatement(sql)) {
            ps.setInt(1, id);
            System.out.println(ps);
            ps.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Erreur delete: " + e.getMessage());
        }
    }
}


