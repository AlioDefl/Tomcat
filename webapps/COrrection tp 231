package controleur;

import modele.*;
import jakarta.servlet.*;
import jakarta.servlet.http.*;
import jakarta.servlet.annotation.WebServlet;
import java.io.*;
import java.sql.Date;

@WebServlet("/Control")  // ← CHANGER : URL de la servlet
public class Control extends HttpServlet {
    
    // === INSTANCIER LES DAO ===
    // ← CHANGER : créer les DAO nécessaires
    private PartieDAO partieDAO = new PartieDAO();
    private JoueurDAO joueurDAO = new JoueurDAO();
    
    public void doGet(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        
        // === RÉCUPÉRER L'ACTION ===
        String action = req.getParameter("action");
        if (action == null) action = "list";  // ← CHANGER : action par défaut
        
        switch (action) {
            
            // ========== ACTION LIST ==========
            // Afficher la liste de tous les éléments
            case "list":
                req.setAttribute("parties", partieDAO.findAll());  // ← CHANGER : nom attribut + DAO
                req.getRequestDispatcher("/WEB-INF/vue/list.jsp").forward(req, res);  // ← CHANGER : JSP
                break;
            
            // ========== ACTION VOIR ==========
            // Afficher les détails d'un élément
            case "voir":
                int idVoir = Integer.parseInt(req.getParameter("id"));
                Partie partieVoir = partieDAO.findById(idVoir);
                
                // *** SI RELATIONS : charger les objets liés ***
                Joueur j1 = joueurDAO.findById(partieVoir.getJno1());
                Joueur j2 = joueurDAO.findById(partieVoir.getJno2());
                
                req.setAttribute("partie", partieVoir);
                req.setAttribute("joueur1", j1);  // ← Pour afficher les pseudos
                req.setAttribute("joueur2", j2);
                req.getRequestDispatcher("/WEB-INF/vue/voir.jsp").forward(req, res);
                break;
            
            // ========== ACTION MODIFIER ==========
            // Afficher le formulaire de modification
            case "modifier":
                int idMod = Integer.parseInt(req.getParameter("id"));
                Partie partieMod = partieDAO.findById(idMod);
                
                req.setAttribute("partie", partieMod);
                // *** POUR LISTES DÉROULANTES : charger TOUTES les options ***
                req.setAttribute("joueurs", joueurDAO.findAll());
                req.getRequestDispatcher("/WEB-INF/vue/modifier.jsp").forward(req, res);
                break;
            
            // ========== ACTION VALIDER ==========
            // Enregistrer les modifications du formulaire
            case "valider":
                Partie p = new Partie();
                
                // Récupérer les valeurs du formulaire
                p.setPno(Integer.parseInt(req.getParameter("pno")));
                p.setJno1(Integer.parseInt(req.getParameter("jno1")));
                p.setJno2(Integer.parseInt(req.getParameter("jno2")));
                p.setStatut(Integer.parseInt(req.getParameter("statut")));
                
                // *** CHAMP DATE (peut être vide) ***
                String dateStr = req.getParameter("date_partie");
                if (dateStr != null && !dateStr.isEmpty()) {
                    p.setDatePartie(Date.valueOf(dateStr));
                }
                
                // *** CHAMP NUMÉRIQUE (peut être vide) ***
                String tempsStr = req.getParameter("temps");
                if (tempsStr != null && !tempsStr.isEmpty()) {
                    p.setTemps(Integer.parseInt(tempsStr));
                }
                
                // *** CHAMP NULLABLE (peut être vide = NULL) ***
                String gagnantStr = req.getParameter("gagnant");
                if (gagnantStr != null && !gagnantStr.isEmpty()) {
                    p.setGagnant(Integer.parseInt(gagnantStr));
                } else {
                    p.setGagnant(null);
                }
                
                partieDAO.update(p);
                res.sendRedirect("Control?action=list");  // REDIRECT après modification !
                break;
            
            // ========== ACTION DELETE ==========
            // Supprimer un élément
            case "delete":
                int idDel = Integer.parseInt(req.getParameter("id"));
                partieDAO.delete(idDel);
                res.sendRedirect("Control?action=list");  // REDIRECT après suppression !
                break;
            
            // ========== ACTION AJOUTER (formulaire vide) ==========
            case "ajouter":
                // Charger les listes pour les select
                req.setAttribute("joueurs", joueurDAO.findAll());
                req.getRequestDispatcher("/WEB-INF/vue/ajouter.jsp").forward(req, res);
                break;
            
            // ========== ACTION INSERER (enregistrer nouveau) ==========
            case "inserer":
                Partie nouvelle = new Partie();
                // ... récupérer les paramètres comme pour valider ...
                // partieDAO.insert(nouvelle);
                res.sendRedirect("Control?action=list");
                break;
            
            // ========== ACTION PAR DÉFAUT ==========
            default:
                res.sendRedirect("Control?action=list");
        }
    }
    
    // POST appelle GET (pour gérer les formulaires)
    public void doPost(HttpServletRequest req, HttpServletResponse res) 
            throws ServletException, IOException {
        doGet(req, res);
    }
}
