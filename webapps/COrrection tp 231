// Méthode basique (MOINS EFFICACE que StringEscapeUtils mais fonctionne)
public static String escape(String input) {
    if (input == null) return "";
    return input
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll("'", "&#39;")
        .replaceAll("\"", "&quot;")
        .replaceAll("&", "&amp;");
}

