║ 48. MVC COMPLET - Exemple avec BDD (parties d'échecs)                   ║
╚═════════════════════════════════════════════════════════════════════════╝

// Dans le contrôleur (avec DAO réels)
case "voir":
    int pno = Integer.parseInt(req.getParameter("pno"));
    PartieDao partieDao = new PartieDao();
    JoueurDao joueurDao = new JoueurDao();
    
    Partie partie = partieDao.findById(pno);
    Joueur joueur1 = joueurDao.findById(partie.getJno1());
    Joueur joueur2 = joueurDao.findById(partie.getJno2());
    
    req.setAttribute("partie", partie);
    req.setAttribute("joueur1", joueur1);
    req.setAttribute("joueur2", joueur2);
    
    RequestDispatcher rd = req.getRequestDispatcher("/WEB-INF/vue/voir.jsp");
    rd.forward(req, res);
    break;

case "modifier":
    int pnoMod = Integer.parseInt(req.getParameter("pno"));
    PartieDao pDao = new PartieDao();
    JoueurDao jDao = new JoueurDao();
    
    Partie p = pDao.findById(pnoMod);
    List<Joueur> tousJoueurs = jDao.findAll();
    
    req.setAttribute("partie", p);
    req.setAttribute("joueurs", tousJoueurs);
    
    RequestDispatcher rdMod = req.getRequestDispatcher("/WEB-INF/vue/modifier.jsp");
    rdMod.forward(req, res);
    break;


