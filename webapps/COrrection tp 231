package modele;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class NomClasseDAO {  // ← CHANGER : NomClasse + DAO
    
    // === CONNEXION === (toujours pareil)
    private static final String URL = "jdbc:postgresql://localhost:5432/but2";  // ← CHANGER : nom base
    private static final String USER = "postgres";   // ← CHANGER si besoin
    private static final String PASS = "postgres";   // ← CHANGER si besoin
    
    // === FIND ALL ===
    public List<NomClasse> findAll() {  // ← CHANGER : type retour
        List<NomClasse> liste = new ArrayList<>();
        String sql = "SELECT * FROM nom_table ORDER BY colonne";  // ← CHANGER : table et tri
        
        try (Connection cnx = DriverManager.getConnection(URL, USER, PASS);
             Statement stmt = cnx.createStatement();
             ResultSet rs = stmt.executeQuery(sql)) {
            
            while (rs.next()) {
                NomClasse obj = new NomClasse();  // ← CHANGER : type
                // ← CHANGER : remplir l'objet selon les colonnes
                obj.setId(rs.getInt("id"));
                obj.setLibelle(rs.getString("libelle"));
                liste.add(obj);
            }
        } catch (SQLException e) { e.printStackTrace(); }
        return liste;
    }
    
    // === FIND BY ID ===
    public NomClasse findById(int id) {  // ← CHANGER : type retour
        NomClasse obj = null;
        String sql = "SELECT * FROM nom_table WHERE id = ?";  // ← CHANGER : table et clé primaire
        
        try (Connection cnx = DriverManager.getConnection(URL, USER, PASS);
             PreparedStatement pstmt = cnx.prepareStatement(sql)) {
            
            pstmt.setInt(1, id);
            System.out.println(pstmt);  // DEBUG obligatoire
            
            try (ResultSet rs = pstmt.executeQuery()) {
                if (rs.next()) {
                    obj = new NomClasse();  // ← CHANGER : type
                    // ← CHANGER : remplir l'objet
                    obj.setId(rs.getInt("id"));
                    obj.setLibelle(rs.getString("libelle"));
                }
            }
        } catch (SQLException e) { e.printStackTrace(); }
        return obj;
    }
    
    // === DELETE ===
    public void delete(int id) {
        String sql = "DELETE FROM nom_table WHERE id = ?";  // ← CHANGER : table et clé primaire
        
        try (Connection cnx = DriverManager.getConnection(URL, USER, PASS);
             PreparedStatement pstmt = cnx.prepareStatement(sql)) {
            
            pstmt.setInt(1, id);
            System.out.println(pstmt);  // DEBUG
            pstmt.executeUpdate();      // executeUpdate pour DELETE !
            
        } catch (SQLException e) { e.printStackTrace(); }
    }
    
    // === UPDATE ===
    public void update(NomClasse obj) {  // ← CHANGER : type paramètre
        String sql = "UPDATE nom_table SET col1=?, col2=? WHERE id=?";  // ← CHANGER : colonnes
        
        try (Connection cnx = DriverManager.getConnection(URL, USER, PASS);
             PreparedStatement pstmt = cnx.prepareStatement(sql)) {
            
            // ← CHANGER : setXxx pour chaque colonne
            pstmt.setString(1, obj.getCol1());
            pstmt.setInt(2, obj.getCol2());
            pstmt.setInt(3, obj.getId());  // WHERE id = ?
            
            System.out.println(pstmt);  // DEBUG
            pstmt.executeUpdate();
            
        } catch (SQLException e) { e.printStackTrace(); }
    }
    
    // === INSERT (si demandé) ===
    public void insert(NomClasse obj) {
        String sql = "INSERT INTO nom_table (col1, col2) VALUES (?, ?)";  // ← CHANGER
        
        try (Connection cnx = DriverManager.getConnection(URL, USER, PASS);
             PreparedStatement pstmt = cnx.prepareStatement(sql)) {
            
            pstmt.setString(1, obj.getCol1());
            pstmt.setInt(2, obj.getCol2());
            
            System.out.println(pstmt);
            pstmt.executeUpdate();
            
        } catch (SQLException e) { e.printStackTrace(); }
    }
}
