    <table border="1" cellpadding="10">
        <tr>
            <th>Entrée</th>
            <td>
                <% if (entree != null) { %>
                    <%= entree %>
                <% } else { %>
                    <em>Non choisie</em>
                <% } %>
            </td>
            <td><a href="MenuControl?action=entree">Modifier</a></td>
        </tr>
        <tr>
            <th>Plat</th>
