</html>


Résumé : Comment ça marche
La SESSION

// Récupérer/créer la session
HttpSession session = req.getSession(true);

// Stocker une valeur
session.setAttribute("entree", "Salade César");

// Récupérer une valeur
String entree = (String) session.getAttribute("entree");

// Supprimer une valeur
session.removeAttribute("entree");

// Vider toute la session
session.invalidate();


