                <% if (plat != null) { %>
                    <%= plat %>
                <% } else { %>
                    <em>Non choisi</em>
                <% } %>
            </td>
            <td><a href="MenuControl?action=plat">Modifier</a></td>
        </tr>
        <tr>
            <th>Dessert</th>
            <td>
                <% if (dessert != null) { %>
                    <%= dessert %>
                <% } else { %>
                    <em>Non choisi</em>
                <% } %>
            </td>
            <td><a href="MenuControl?action=dessert">Modifier</a></td>
        </tr>
    </table>
    
    <br>
    
    <% if (entree != null && plat != null && dessert != null) { %>
        <p style="color: green; font-weight: bold;">✅ Commande complète !</p>
